# ===========================================
# HopDrop Backend - Configuration
# ===========================================

# === Base de données ===
DATABASE_URL="postgresql://user:password@localhost:5432/hopdrop?schema=public"

# === JWT ===
JWT_SECRET="your-secret-min-32-characters"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-characters"

# === Serveur ===
PORT=3000
NODE_ENV=development

# === Cloudinary (Upload d'images) ===
# Créez un compte gratuit sur https://cloudinary.com
# Dashboard > Settings > Access Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# URL de base pour uploads locaux (fallback si Cloudinary non configuré)
UPLOADS_BASE_URL=http://localhost:3000

# === OpenAI (Analyse IA) ===
OPENAI_API_KEY=your-openai-api-key
USE_MOCK_AI=true

# === Stripe (Paiements) - Phase 2 ===
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# === Firebase (Notifications) - Phase 2 ===
# https://console.firebase.google.com > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# === Email (Resend) ===
RESEND_API_KEY=
EMAIL_FROM=noreply@hopdrop.fr
